<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ═══════════════════════════════════════════════
       PAPERFORMAT
  ═══════════════════════════════════════════════ -->
  <record id="paperformat_mitimi_devis" model="report.paperformat">
    <field name="name">MITIMI &#8212; Devis A4</field>
    <field name="default"        eval="False"/>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">8</field>
    <field name="margin_bottom">8</field>
    <field name="margin_left">8</field>
    <field name="margin_right">8</field>
    <field name="header_line"    eval="False"/>
    <field name="header_spacing">0</field>
    <field name="dpi">96</field>
  </record>

  <!-- ═══════════════════════════════════════════════
       ACTION RAPPORT
  ═══════════════════════════════════════════════ -->
  <record id="action_report_mitimi_devis" model="ir.actions.report">
    <field name="name">Devis / Commande MITIMI</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">custom_sale_report_mitimi.report_mitimi_devis</field>
    <field name="report_file">custom_sale_report_mitimi.report_mitimi_devis</field>
    <field name="paperformat_id" ref="paperformat_mitimi_devis"/>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">
      ('Devis %s' if object.state in ('draft','sent') else 'Bon de commande %s') % (object.name,)
    </field>
  </record>

  <!-- Override bouton "Imprimer Devis" standard Odoo -->
  <record id="sale.action_report_saleorder" model="ir.actions.report">
    <field name="report_name">custom_sale_report_mitimi.report_mitimi_devis</field>
    <field name="paperformat_id" ref="paperformat_mitimi_devis"/>
  </record>

  <!-- ═══════════════════════════════════════════════
       TEMPLATE QWeb
  ═══════════════════════════════════════════════ -->
  <template id="report_mitimi_devis">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">

        <div style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #1A1A2E; background: #ffffff; margin: 0; padding: 0;">

          <!-- ════════════════════════════
               HEADER
          ════════════════════════════ -->
          <table style="width:100%; border-collapse:collapse;">
            <tr>

              <!-- Gauche : logo + nom + tagline -->
              <td style="padding: 20px 10px 16px 20px; vertical-align: top;">
                <table style="border-collapse:collapse;">
                  <tr>
                    <td style="vertical-align: middle;">
                      <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" style="height: 80px; width: auto;" alt="Logo"/>
                      <img t-else="" src="/custom_sale_report_mitimi/static/img/logo_mitimi.png" height="80" width="133" style="height: 80px; width: 133px;" alt="Logo"/>
                    </td>
                  </tr>
                </table>
                <div style="margin-top: 8px; border-left: 3.5px solid #00C5D5; padding-left: 10px; font-size: 10.5px; color: #4A5568; line-height: 1.55; white-space: nowrap;">
                  L&#8217;expertise qui connecte votre entreprise &#224; l&#8217;avenir.
                </div>
              </td>

              <!-- Droite : titre + n&#176; + infos -->
              <td style="padding: 20px 20px 16px 10px; vertical-align: top; text-align: right;">
                <t t-if="doc.state in ('draft', 'sent')">
                  <div style="font-size: 46px; font-weight: 800; color: #1A1A2E; letter-spacing: 4px; line-height: 1;">DEVIS</div>
                </t>
                <t t-else="">
                  <div style="font-size: 26px; font-weight: 800; color: #1A1A2E; letter-spacing: 2px; line-height: 1.2;">BON DE COMMANDE</div>
                </t>

                <div style="margin-top: 6px; background-color: #00C5D5; color: #ffffff; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; padding: 4px 14px; border-radius: 4px; display: inline-block;">
                  N&#176; <t t-esc="doc.name"/>
                </div>

                <div style="margin-top: 8px; font-size: 11px; color: #4A5568; text-align: right; line-height: 1.85;">
                  <div>
                    Date&#160;: <span style="color: #1A1A2E; font-weight: 600;">
                      <t t-esc="doc.date_order.strftime('%d/%m/%Y') if doc.date_order else ''"/>
                    </span>
                  </div>
                  <div>
                    Validit&#233;&#160;: <span style="color: #1A1A2E; font-weight: 600;">
                      <t t-esc="doc.mitimi_validity_label or '30 jours'"/>
                    </span>
                  </div>
                  <div>
                    &#201;tabli par&#160;: <span style="color: #1A1A2E; font-weight: 600;">
                      <t t-esc="doc.company_id.name"/>
                    </span>
                  </div>
                </div>
              </td>

            </tr>
          </table>

          <!-- ════════════════════════════
               PARTIES : &#201;METTEUR / DESTINATAIRE
          ════════════════════════════ -->
          <div style="padding: 0 20px 14px;">
          <table style="width:100%; border-collapse:separate; border-spacing:0;">
            <tr>

              <!-- &#201;metteur -->
              <td style="width: 49%; vertical-align: top; border: 1.5px solid #A8E6EF; border-radius: 8px; padding: 14px 16px;">
                <div>
                  <div style="font-size: 9px; font-weight: 700; letter-spacing: 2.5px; color: #00C5D5; text-transform: uppercase; margin-bottom: 10px;">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 4px;"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4z"/></svg>
                    &#201;METTEUR
                  </div>
                  <div style="font-weight: 700; font-size: 12px; margin-bottom: 4px;"><t t-esc="doc.company_id.name"/></div>
                  <div style="font-size: 11px; color: #4A5568; line-height: 1.7; margin-bottom: 8px;">
                    <t t-if="doc.company_id.partner_id.street">
                      <t t-esc="doc.company_id.partner_id.street"/><br/>
                    </t>
                    <t t-if="doc.company_id.partner_id.street2">
                      <t t-esc="doc.company_id.partner_id.street2"/><br/>
                    </t>
                    <t t-esc="(doc.company_id.partner_id.zip or '') + ' ' + (doc.company_id.partner_id.city or '')"/>
                    <t t-if="doc.company_id.partner_id.country_id">
                      , <t t-esc="doc.company_id.partner_id.country_id.name"/>
                    </t>
                  </div>
                  <t t-if="doc.company_id.phone">
                    <div style="font-size: 11px; color: #1A1A2E; margin-top: 4px;">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 5px;"><path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328z"/></svg>
                      <t t-esc="doc.company_id.phone"/>
                    </div>
                  </t>
                  <t t-if="doc.company_id.email">
                    <div style="font-size: 11px; color: #1A1A2E; margin-top: 4px;">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 5px;"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2zm13 2.383-4.708 2.825L15 11.105V5.383zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741zM1 11.105l4.708-2.897L1 5.383v5.722z"/></svg>
                      <t t-esc="doc.company_id.email"/>
                    </div>
                  </t>
                  <t t-if="doc.company_id.website">
                    <div style="font-size: 11px; color: #1A1A2E; margin-top: 4px;">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 5px;"><path d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm7.5-6.923c-.67.204-1.335.82-1.887 1.855A4.98 4.98 0 0 0 5.34 4V1.077zM4.249 3.539a7.01 7.01 0 0 0-1.198-.49A7.01 7.01 0 0 0 3.051 3.05c.362.184.763.349 1.198.49zM8.5 11.91c-.81.03-1.577.13-2.282.287.12.312.252.604.395.872.552 1.035 1.218 1.65 1.887 1.855V11.91z"/></svg>
                      <t t-esc="doc.company_id.website"/>
                    </div>
                  </t>
                </div>
              </td>

              <td style="width: 2%; padding: 0; border: none;"></td>

              <!-- Destinataire -->
              <td style="width: 49%; vertical-align: top; border: 1.5px solid #A8E6EF; border-radius: 8px; padding: 14px 16px;">
                <div>
                  <div style="font-size: 9px; font-weight: 700; letter-spacing: 2.5px; color: #00C5D5; text-transform: uppercase; margin-bottom: 10px;">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 4px;"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4z"/></svg>
                    DESTINATAIRE
                  </div>
                  <div style="font-weight: 700; font-size: 12px; margin-bottom: 4px;"><t t-esc="doc.partner_id.name"/></div>
                  <div style="font-size: 11px; color: #4A5568; line-height: 1.7; margin-bottom: 8px;">
                    <t t-if="doc.partner_id.street"><t t-esc="doc.partner_id.street"/><br/></t>
                    <t t-if="doc.partner_id.street2"><t t-esc="doc.partner_id.street2"/><br/></t>
                    <t t-esc="(doc.partner_id.zip or '') + ' ' + (doc.partner_id.city or '')"/>
                    <t t-if="doc.partner_id.country_id">, <t t-esc="doc.partner_id.country_id.name"/></t>
                  </div>
                  <t t-if="doc.partner_id.phone">
                    <div style="font-size: 11px; color: #1A1A2E; margin-top: 4px;">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 5px;"><path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328z"/></svg>
                      <t t-esc="doc.partner_id.phone"/>
                    </div>
                  </t>
                  <t t-if="doc.partner_id.email">
                    <div style="font-size: 11px; color: #1A1A2E; margin-top: 4px;">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 5px;"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2zm13 2.383-4.708 2.825L15 11.105V5.383zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741zM1 11.105l4.708-2.897L1 5.383v5.722z"/></svg>
                      <t t-esc="doc.partner_id.email"/>
                    </div>
                  </t>
                </div>
              </td>

            </tr>
          </table>
          </div>

          <!-- ════════════════════════════
               PROJET / OBJET
          ════════════════════════════ -->
          <t t-if="doc.mitimi_objet">
            <div style="margin: 0 20px 14px; border: 1.5px solid #A8E6EF; border-radius: 8px; overflow: hidden;">
              <table style="width:100%; border-collapse:collapse;">
                <tr>
                  <td style="width: 56px; background: -webkit-linear-gradient(135deg, #00C5D5, #005F6B); background: linear-gradient(135deg, #00C5D5, #005F6B); text-align: center; vertical-align: middle; padding: 14px 0;">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                      <rect x="8" y="2" width="8" height="4" rx="1" ry="1"/>
                      <line x1="9" y1="12" x2="15" y2="12"/>
                      <line x1="9" y1="16" x2="13" y2="16"/>
                    </svg>
                  </td>
                  <td style="padding: 12px 16px; vertical-align: middle;">
                    <div style="font-size: 9px; font-weight: 700; letter-spacing: 2.5px; color: #00C5D5; text-transform: uppercase; margin-bottom: 3px;">Projet concern&#233;</div>
                    <div style="font-weight: 700; font-size: 12px; color: #1A1A2E;"><t t-esc="doc.mitimi_objet"/></div>
                  </td>
                </tr>
              </table>
            </div>
          </t>

          <!-- ════════════════════════════
               TITRE SECTION
          ════════════════════════════ -->
          <div style="padding: 4px 20px 7px; font-size: 10px; font-weight: 700; letter-spacing: 2.5px; color: #00C5D5; text-transform: uppercase;">
            Proposition Financi&#232;re
          </div>

          <!-- ════════════════════════════
               TABLEAU DES LIGNES
          ════════════════════════════ -->
          <t t-set="show_uom" t-value="doc.mitimi_show_uom()"/>
          <t t-set="ncols" t-value="7 if show_uom else 6"/>
          <div style="padding: 0 20px;">
          <table style="width:100%; border-collapse: collapse; font-size: 12px;">
            <colgroup>
              <col style="width: 30px;"/>
              <col style="width: 130px;"/>
              <col/>
              <col t-if="show_uom" style="width: 48px;"/>
              <col style="width: 32px;"/>
              <col style="width: 105px;"/>
              <col style="width: 105px;"/>
            </colgroup>
            <thead>
              <tr style="background-color: #005F6B;">
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:center; white-space:nowrap; border:none;">N&#176;</th>
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:left; white-space:nowrap; border:none;">D&#233;signation</th>
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:left; white-space:nowrap; border:none;">D&#233;tail / Description</th>
                <th t-if="show_uom" style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:center; white-space:nowrap; border:none;">Unit&#233;</th>
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:center; white-space:nowrap; border:none;">Qt&#233;</th>
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:center; white-space:nowrap; border:none;">P.U. HT</th>
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:center; white-space:nowrap; border:none;">Montant HT</th>
              </tr>
            </thead>
            <tbody>
              <t t-set="line_num" t-value="0"/>
              <t t-foreach="doc.order_line" t-as="line">
                <t t-if="line.display_type == 'line_section'">
                  <tr style="page-break-inside: avoid;">
                    <td t-att-colspan="ncols" style="padding:9px 8px; background-color:#E3F6F9; color:#005F6B; font-weight:700; font-size:11.5px; letter-spacing:0.5px; border-bottom:1px solid #D8EFF3;">
                      <t t-esc="line.name"/>
                    </td>
                  </tr>
                </t>
                <t t-elif="line.display_type == 'line_note'">
                  <tr style="page-break-inside: avoid;">
                    <td t-att-colspan="ncols" style="padding:8px 8px; color:#4A5568; font-style:italic; font-size:11px; border-bottom:1px solid #D8EFF3;">
                      <t t-esc="line.name"/>
                    </td>
                  </tr>
                </t>
                <t t-else="">
                <t t-set="line_num" t-value="line_num + 1"/>
                <t t-if="line_num % 2 == 0">
                  <t t-set="row_bg" t-value="'#F2FBFC'"/>
                </t>
                <t t-else="">
                  <t t-set="row_bg" t-value="'#FFFFFF'"/>
                </t>
                <tr style="border-bottom: 1px solid #D8EFF3; page-break-inside: avoid;">
                  <td t-att-style="'padding:12px 8px; text-align:center; vertical-align:middle; background-color:' + row_bg">
                    <span style="font-size: 20px; font-weight: 700; color: #00C5D5; line-height: 1;">
                      <t t-esc="line_num"/>
                    </span>
                  </td>
                  <td t-if="line.product_id" t-att-style="'padding:12px 8px; text-align:left; font-weight:600; font-size:12px; vertical-align:middle; background-color:' + row_bg">
                    <t t-esc="line.product_id.name"/>
                  </td>
                  <td t-att-colspan="1 if line.product_id else 2" t-att-style="'padding:12px 8px; text-align:left; color:#4A5568; font-size:11.5px; line-height:1.6; vertical-align:middle; background-color:' + row_bg">
                    <t t-esc="line.name"/>
                  </td>
                  <td t-if="show_uom" t-att-style="'padding:12px 8px; text-align:center; vertical-align:middle; font-size:11.5px; background-color:' + row_bg">
                    <t t-esc="line.product_uom_id.name if line.product_uom_id else ''"/>
                  </td>
                  <td t-att-style="'padding:12px 8px; text-align:center; vertical-align:middle; font-size:11.5px; background-color:' + row_bg">
                    <t t-esc="int(line.product_uom_qty) if line.product_uom_qty == int(line.product_uom_qty) else line.product_uom_qty"/>
                  </td>
                  <td t-att-style="'padding:12px 8px; text-align:right; font-weight:500; vertical-align:middle; white-space:nowrap; font-size:11.5px; background-color:' + row_bg">
                    <t t-esc="'{:,.0f}'.format(line.price_unit).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                  </td>
                  <td t-att-style="'padding:12px 8px; text-align:right; font-weight:700; vertical-align:middle; white-space:nowrap; font-size:11.5px; background-color:' + row_bg">
                    <t t-esc="'{:,.0f}'.format(line.price_subtotal).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                  </td>
                </tr>
                </t>
              </t>
            </tbody>
          </table>
          </div>

          <!-- ════════════════════════════
               BAS DE PAGE
          ════════════════════════════ -->
          <div style="page-break-inside: avoid;">
          <table style="width:100%; border-collapse:collapse; margin-top: 2px;">
            <tr>

              <!-- Conditions -->
              <td style="width: 57%; padding: 12px 8px 8px 20px; vertical-align: top;">
                <div style="border: 1.5px solid #A8E6EF; border-radius: 8px; padding: 13px 15px;">
                  <div style="font-size: 9px; font-weight: 700; letter-spacing: 2.5px; color: #00C5D5; text-transform: uppercase; margin-bottom: 9px;">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 4px;"><path d="M5.5 7a.5.5 0 0 0 0 1h5a.5.5 0 0 0 0-1h-5zM5 9.5a.5.5 0 0 1 .5-.5h5a.5.5 0 0 1 0 1h-5a.5.5 0 0 1-.5-.5zm0 2a.5.5 0 0 1 .5-.5h2a.5.5 0 0 1 0 1h-2a.5.5 0 0 1-.5-.5z"/><path d="M9.5 0H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5L9.5 0zm0 1v2A1.5 1.5 0 0 0 11 4.5h2V14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h5.5z"/></svg>
                    Termes et Conditions
                  </div>
                  <div style="font-size: 10.5px; color: #4A5568; line-height: 1.75;">
                    <t t-if="doc.mitimi_delivery_licence">
                      <div style="margin-bottom: 3px;">D&#233;lai de livraison de licences / mat&#233;riels&#160;: <t t-esc="doc.mitimi_delivery_licence"/></div>
                    </t>
                    <t t-if="doc.mitimi_delivery_project">
                      <div style="margin-bottom: 3px;">D&#233;lai de livraison du projet&#160;: <t t-esc="doc.mitimi_delivery_project"/></div>
                    </t>
                    <t t-if="doc.mitimi_payment_conditions">
                      <div style="margin-bottom: 3px;">Conditions de vente souhait&#233;es&#160;: <b><t t-esc="doc.mitimi_payment_conditions"/></b></div>
                    </t>
                    <t t-if="doc.mitimi_payment_method">
                      <div style="margin-bottom: 3px;">Mode de paiement&#160;: <b><t t-esc="doc.mitimi_payment_method"/></b></div>
                    </t>
                    <t t-if="doc.mitimi_warranty">
                      <div style="margin-bottom: 3px; font-weight: 700; color: #1A1A2E;">GARANTIE ET SUPPORT&#160;: <t t-esc="doc.mitimi_warranty"/></div>
                    </t>
                    <t t-if="not doc.mitimi_payment_conditions and not doc.mitimi_payment_method and not doc.mitimi_delivery_project">
                      <div style="margin-bottom: 3px;">&#8226;&#160;Devis gratuit et sans engagement.</div>
                      <div style="margin-bottom: 3px;">&#8226;&#160;Prix valables 30&#160;jours &#224; compter de la date d&#8217;&#233;mission.</div>
                      <div>&#8226;&#160;D&#233;lai d&#8217;ex&#233;cution&#160;: &#224; d&#233;finir selon planning valid&#233;.</div>
                    </t>
                  </div>
                </div>
              </td>

              <!-- Totaux + Bon pour accord -->
              <td style="width: 43%; padding: 12px 20px 8px 8px; vertical-align: top;">

                <!-- Totaux -->
                <table style="width:100%; border-collapse:collapse; border-radius: 8px; overflow: hidden; margin-bottom: 10px;">
                  <tr>
                    <td style="background-color: #005F6B; color: #ffffff; font-size: 12px; font-weight: 700; padding: 9px 14px;">TOTAL HT</td>
                    <td style="background-color: #005F6B; color: #ffffff; font-size: 12px; font-weight: 700; padding: 9px 14px; text-align: right; white-space: nowrap;">
                      <t t-esc="'{:,.0f}'.format(doc.mitimi_total_ht).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                    </td>
                  </tr>
                  <t t-if="doc.mitimi_remise and doc.mitimi_remise > 0">
                    <tr>
                      <td style="background-color: #007A85; color: #ffffff; font-size: 11px; font-weight: 600; padding: 8px 14px;">
                        Remise (<t t-esc="'{:.0f}'.format(doc.mitimi_remise * 100)"/>&#160;%)
                      </td>
                      <td style="background-color: #007A85; color: #ffffff; font-size: 11px; padding: 8px 14px; text-align: right; white-space: nowrap;">
                        &#8722;&#160;<t t-esc="'{:,.0f}'.format(doc.mitimi_remise_amount or 0).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                      </td>
                    </tr>
                  </t>
                  <tr>
                    <td style="background-color: #007A85; color: #ffffff; font-size: 11px; font-weight: 600; padding: 8px 14px;">
                      TVA
                      <t t-set="tva_label" t-value="doc.mitimi_tva_label()"/>
                      <t t-if="tva_label">(<t t-esc="tva_label"/>)</t>
                    </td>
                    <td style="background-color: #007A85; color: #ffffff; font-size: 11px; padding: 8px 14px; text-align: right; white-space: nowrap;">
                      <t t-esc="'{:,.0f}'.format(doc.mitimi_tva_amount).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                    </td>
                  </tr>
                  <tr>
                    <td style="background-color: #00C5D5; color: #ffffff; font-size: 14px; font-weight: 800; padding: 9px 14px; letter-spacing: 0.3px;">TOTAL TTC</td>
                    <td style="background-color: #00C5D5; color: #ffffff; font-size: 14px; font-weight: 800; padding: 9px 14px; text-align: right; white-space: nowrap;">
                      <t t-esc="'{:,.0f}'.format(doc.mitimi_total_ttc).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                    </td>
                  </tr>
                </table>

                <!-- Bon pour accord -->
                <div style="border: 1.5px solid #A8E6EF; border-radius: 8px; padding: 12px 15px;">
                  <div style="font-size: 10px; font-weight: 700; color: #00C5D5; margin-bottom: 7px;">
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 4px;"><path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793 14.207 5.5l1.647-1.646a.5.5 0 0 0 0-.708l-3-3zm.646 6.061L9.793 2.5 3.293 9H3.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.207l6.5-6.5zm-7.468 7.468A.5.5 0 0 1 6 13.5V13h-.5a.5.5 0 0 1-.5-.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.5-.5V10h-.5a.499.499 0 0 1-.175-.032l-.179.178a.5.5 0 0 0-.11.168l-2 5a.5.5 0 0 0 .65.65l5-2a.5.5 0 0 0 .168-.11l.178-.178z"/></svg>
                    BON POUR ACCORD
                  </div>
                  <div style="font-size: 11px; color: #4A5568; border-bottom: 1px solid #C8DEE2; padding-bottom: 4px; margin-bottom: 7px; line-height: 2.2;">
                    Date&#160;: ___ / ___ / <t t-esc="doc.date_order.year if doc.date_order else ''"/>
                  </div>
                  <div style="font-size: 10.5px; color: #4A5568;">Signature et cachet&#160;:</div>
                  <div style="height: 36px;"></div>
                </div>

              </td>
            </tr>
          </table>

          <!-- ════════════════════════════
               FOOTER : SERVICES
          ════════════════════════════ -->
          <table style="width:100%; border-collapse:collapse; margin-top: 12px; background: -webkit-linear-gradient(left, #005F6B, #00C5D5); background: linear-gradient(to right, #005F6B, #00C5D5);">
            <tr>
              <td style="padding: 11px 10px; text-align: center; vertical-align: middle;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span style="color: #ffffff; font-size: 11px; font-weight: 600; vertical-align: middle;">Services-conseils</span>
              </td>
              <td style="width: 1px; background-color: #7EEAF0; padding: 0;"></td>
              <td style="padding: 11px 10px; text-align: center; vertical-align: middle;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><circle cx="12" cy="12" r="3"/><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/></svg>
                <span style="color: #ffffff; font-size: 11px; font-weight: 600; vertical-align: middle;">Services d&#8217;ex&#233;cution</span>
              </td>
              <td style="width: 1px; background-color: #7EEAF0; padding: 0;"></td>
              <td style="padding: 11px 10px; text-align: center; vertical-align: middle;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                <span style="color: #ffffff; font-size: 11px; font-weight: 600; vertical-align: middle;">Centre d&#8217;excellence technologique</span>
              </td>
            </tr>
          </table>

          <!-- ════════════════════════════
               FOOTER : MENTIONS LEGALES
          ════════════════════════════ -->
          <div style="background-color: #0D1B2A; padding: 14px 28px; text-align: center; font-size: 10px; color: #E2E8F0; line-height: 1.8;">
            <t t-foreach="doc.company_id.mitimi_footer_lines()" t-as="footer_line">
              <div t-att-style="'font-size: 11px; font-weight: 700; color: #FFFFFF; letter-spacing: 0.3px;' if footer_line_first else ''"><t t-esc="footer_line"/></div>
            </t>
          </div>
          </div>

        </div>
      </t>
    </t>
  </template>

</odoo>