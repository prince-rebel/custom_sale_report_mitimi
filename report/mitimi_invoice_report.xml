<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <!-- ═══════════════════════════════════════════════
       PAPERFORMAT FACTURE
  ═══════════════════════════════════════════════ -->
  <record id="paperformat_mitimi_invoice" model="report.paperformat">
    <field name="name">MITIMI &#8212; Facture A4</field>
    <field name="default"        eval="False"/>
    <field name="format">A4</field>
    <field name="orientation">Portrait</field>
    <field name="margin_top">8</field>
    <field name="margin_bottom">8</field>
    <field name="margin_left">8</field>
    <field name="margin_right">8</field>
    <field name="header_line"    eval="False"/>
    <field name="header_spacing">0</field>
    <field name="dpi">96</field>
  </record>

  <!-- ═══════════════════════════════════════════════
       ACTION RAPPORT FACTURE
  ═══════════════════════════════════════════════ -->
  <record id="action_report_mitimi_invoice" model="ir.actions.report">
    <field name="name">Facture MITIMI</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">custom_sale_report_mitimi.report_mitimi_invoice</field>
    <field name="report_file">custom_sale_report_mitimi.report_mitimi_invoice</field>
    <field name="paperformat_id" ref="paperformat_mitimi_invoice"/>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>
    <field name="print_report_name">
      ('Avoir %s' if object.move_type == 'out_refund' else 'Facture %s') % (object.name,)
    </field>
  </record>

  <!-- ═══════════════════════════════════════════════
       TEMPLATE QWeb FACTURE
  ═══════════════════════════════════════════════ -->
  <template id="report_mitimi_invoice">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="doc">

        <div style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #1A1A2E; background: #ffffff; margin: 0; padding: 0;">

          <!-- ════════════════════════════
               HEADER
          ════════════════════════════ -->
          <table style="width:100%; border-collapse:collapse;">
            <tr>

              <!-- Gauche : logo + nom + tagline -->
              <td style="padding: 20px 10px 16px 20px; vertical-align: top;">
                <table style="border-collapse:collapse;">
                  <tr>
                    <td style="vertical-align: middle;">
                      <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" style="height: 80px; width: auto;" alt="Logo"/>
                      <img t-else="" src="/custom_sale_report_mitimi/static/img/logo_mitimi.png" height="80" width="133" style="height: 80px; width: 133px;" alt="Logo"/>
                    </td>
                  </tr>
                </table>
                <div style="margin-top: 8px; border-left: 3.5px solid #00C5D5; padding-left: 10px; font-size: 10.5px; color: #4A5568; line-height: 1.55;">
                  L&#8217;expertise qui connecte<br/>votre entreprise &#224; l&#8217;avenir.
                </div>
              </td>

              <!-- Droite : titre + n&#176; + infos -->
              <td style="padding: 20px 20px 16px 10px; vertical-align: top; text-align: right;">
                <t t-if="doc.move_type == 'out_refund'">
                  <div style="font-size: 46px; font-weight: 800; color: #1A1A2E; letter-spacing: 4px; line-height: 1;">AVOIR</div>
                </t>
                <t t-else="">
                  <div style="font-size: 46px; font-weight: 800; color: #1A1A2E; letter-spacing: 4px; line-height: 1;">FACTURE</div>
                </t>

                <div style="margin-top: 6px; background-color: #00C5D5; color: #ffffff; font-size: 11px; font-weight: 700; letter-spacing: 0.8px; padding: 4px 14px; border-radius: 4px; display: inline-block;">
                  N&#176; <t t-esc="doc.name"/>
                </div>

                <div style="margin-top: 8px; font-size: 11px; color: #4A5568; text-align: right; line-height: 1.85;">
                  <div>
                    Date&#160;: <span style="color: #1A1A2E; font-weight: 600;">
                      <t t-esc="doc.invoice_date.strftime('%d/%m/%Y') if doc.invoice_date else ''"/>
                    </span>
                  </div>
                  <t t-if="doc.invoice_date_due">
                    <div>
                      &#201;ch&#233;ance&#160;:
                      <span style="color: #e53e3e; font-weight: 700;">
                        <t t-esc="doc.invoice_date_due.strftime('%d/%m/%Y')"/>
                      </span>
                    </div>
                  </t>
                  <t t-if="doc.invoice_origin">
                    <div>
                      R&#233;f. commande&#160;: <span style="color: #1A1A2E; font-weight: 600;">
                        <t t-esc="doc.invoice_origin"/>
                      </span>
                    </div>
                  </t>
                  <t t-if="doc.invoice_payment_term_id">
                    <div>
                      Conditions&#160;: <span style="color: #1A1A2E; font-weight: 600;">
                        <t t-esc="doc.invoice_payment_term_id.name"/>
                      </span>
                    </div>
                  </t>
                </div>
              </td>

            </tr>
          </table>

          <!-- ════════════════════════════
               PARTIES
          ════════════════════════════ -->
          <table style="width:100%; border-collapse:collapse;">
            <tr>

              <!-- &#201;metteur -->
              <td style="width: 49%; padding: 0 8px 14px 20px; vertical-align: top;">
                <div style="border: 1.5px solid #A8E6EF; border-radius: 8px; padding: 14px 16px;">
                  <div style="font-size: 9px; font-weight: 700; letter-spacing: 2.5px; color: #00C5D5; text-transform: uppercase; margin-bottom: 10px;">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 4px;"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4z"/></svg>
                    &#201;METTEUR
                  </div>
                  <div style="font-weight: 700; font-size: 12px; margin-bottom: 4px;"><t t-esc="doc.company_id.name"/></div>
                  <div style="font-size: 11px; color: #4A5568; line-height: 1.7; margin-bottom: 8px;">
                    <t t-if="doc.company_id.partner_id.street">
                      <t t-esc="doc.company_id.partner_id.street"/><br/>
                    </t>
                    <t t-if="doc.company_id.partner_id.street2">
                      <t t-esc="doc.company_id.partner_id.street2"/><br/>
                    </t>
                    <t t-esc="(doc.company_id.partner_id.zip or '') + ' ' + (doc.company_id.partner_id.city or '')"/>
                    <t t-if="doc.company_id.partner_id.country_id">
                      , <t t-esc="doc.company_id.partner_id.country_id.name"/>
                    </t>
                  </div>
                  <t t-if="doc.company_id.phone">
                    <div style="font-size: 11px; color: #1A1A2E; margin-top: 4px;">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 5px;"><path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328z"/></svg>
                      <t t-esc="doc.company_id.phone"/>
                    </div>
                  </t>
                  <t t-if="doc.company_id.email">
                    <div style="font-size: 11px; color: #1A1A2E; margin-top: 4px;">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 5px;"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2zm13 2.383-4.708 2.825L15 11.105V5.383zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741zM1 11.105l4.708-2.897L1 5.383v5.722z"/></svg>
                      <t t-esc="doc.company_id.email"/>
                    </div>
                  </t>
                  <t t-if="doc.company_id.vat">
                    <div style="font-size: 11px; color: #1A1A2E; margin-top: 4px; font-weight: 600;">
                      NIF&#160;: <t t-esc="doc.company_id.vat"/>
                    </div>
                  </t>
                </div>
              </td>

              <!-- Client -->
              <td style="width: 49%; padding: 0 20px 14px 8px; vertical-align: top;">
                <div style="border: 1.5px solid #A8E6EF; border-radius: 8px; padding: 14px 16px;">
                  <div style="font-size: 9px; font-weight: 700; letter-spacing: 2.5px; color: #00C5D5; text-transform: uppercase; margin-bottom: 10px;">
                    <svg width="13" height="13" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 4px;"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4z"/></svg>
                    CLIENT
                  </div>
                  <div style="font-weight: 700; font-size: 12px; margin-bottom: 4px;"><t t-esc="doc.partner_id.name"/></div>
                  <div style="font-size: 11px; color: #4A5568; line-height: 1.7; margin-bottom: 8px;">
                    <t t-if="doc.partner_id.street"><t t-esc="doc.partner_id.street"/><br/></t>
                    <t t-if="doc.partner_id.street2"><t t-esc="doc.partner_id.street2"/><br/></t>
                    <t t-esc="(doc.partner_id.zip or '') + ' ' + (doc.partner_id.city or '')"/>
                    <t t-if="doc.partner_id.country_id">, <t t-esc="doc.partner_id.country_id.name"/></t>
                  </div>
                  <t t-if="doc.partner_id.phone">
                    <div style="font-size: 11px; color: #1A1A2E; margin-top: 4px;">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 5px;"><path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.568 17.568 0 0 0 4.168 6.608 17.569 17.569 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.678.678 0 0 0-.58-.122l-2.19.547a1.745 1.745 0 0 1-1.657-.459L5.482 8.062a1.745 1.745 0 0 1-.46-1.657l.548-2.19a.678.678 0 0 0-.122-.58L3.654 1.328z"/></svg>
                      <t t-esc="doc.partner_id.phone"/>
                    </div>
                  </t>
                  <t t-if="doc.partner_id.email">
                    <div style="font-size: 11px; color: #1A1A2E; margin-top: 4px;">
                      <svg width="11" height="11" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 5px;"><path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2zm13 2.383-4.708 2.825L15 11.105V5.383zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741zM1 11.105l4.708-2.897L1 5.383v5.722z"/></svg>
                      <t t-esc="doc.partner_id.email"/>
                    </div>
                  </t>
                  <t t-if="doc.partner_id.vat">
                    <div style="font-size: 11px; color: #1A1A2E; margin-top: 4px; font-weight: 600;">
                      NIF&#160;: <t t-esc="doc.partner_id.vat"/>
                    </div>
                  </t>
                </div>
              </td>

            </tr>
          </table>

          <!-- ════════════════════════════
               TITRE SECTION
          ════════════════════════════ -->
          <div style="padding: 4px 20px 7px; font-size: 10px; font-weight: 700; letter-spacing: 2.5px; color: #00C5D5; text-transform: uppercase;">
            D&#233;tail de la Facturation
          </div>

          <!-- ════════════════════════════
               TABLEAU DES LIGNES
          ════════════════════════════ -->
          <table style="width: calc(100% - 40px); margin: 0 20px; border-collapse: collapse; font-size: 12px;">
            <colgroup>
              <col style="width: 30px;"/>
              <col style="width: 130px;"/>
              <col/>
              <col style="width: 48px;"/>
              <col style="width: 32px;"/>
              <col style="width: 105px;"/>
              <col style="width: 105px;"/>
            </colgroup>
            <thead>
              <tr style="background: -webkit-linear-gradient(left, #005F6B, #00C5D5); background: linear-gradient(to right, #005F6B, #00C5D5);">
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:center; white-space:nowrap; border:none;">N&#176;</th>
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:left; white-space:nowrap; border:none;">D&#233;signation</th>
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:left; white-space:nowrap; border:none;">Description</th>
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:center; white-space:nowrap; border:none;">Unit&#233;</th>
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:center; white-space:nowrap; border:none;">Qt&#233;</th>
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:center; white-space:nowrap; border:none;">P.U. HT</th>
                <th style="color:#fff; font-size:9.5px; font-weight:600; letter-spacing:0.8px; text-transform:uppercase; padding:10px 8px; text-align:center; white-space:nowrap; border:none;">Montant HT</th>
              </tr>
            </thead>
            <tbody>
              <t t-set="line_num" t-value="0"/>
              <t t-foreach="doc.invoice_line_ids" t-as="line">
                <t t-if="line.display_type not in ('line_section', 'line_note')">
                  <t t-set="line_num" t-value="line_num + 1"/>
                  <t t-if="line_num % 2 == 0">
                    <t t-set="row_bg" t-value="'#F2FBFC'"/>
                  </t>
                  <t t-else="">
                    <t t-set="row_bg" t-value="'#FFFFFF'"/>
                  </t>
                  <tr style="border-bottom: 1px solid #D8EFF3;">
                    <td t-att-style="'padding:12px 8px; text-align:center; vertical-align:middle; background-color:' + row_bg">
                      <span style="font-size: 20px; font-weight: 700; color: #00C5D5; line-height: 1;">
                        <t t-esc="line_num"/>
                      </span>
                    </td>
                    <td t-att-style="'padding:12px 8px; text-align:left; font-weight:600; font-size:12px; vertical-align:middle; background-color:' + row_bg">
                      <t t-esc="line.product_id.name if line.product_id else ''"/>
                    </td>
                    <td t-att-style="'padding:12px 8px; text-align:left; color:#4A5568; font-size:11.5px; line-height:1.6; vertical-align:middle; background-color:' + row_bg">
                      <t t-esc="line.name"/>
                    </td>
                    <td t-att-style="'padding:12px 8px; text-align:center; vertical-align:middle; font-size:11.5px; background-color:' + row_bg">
                      <t t-esc="line.product_uom_id.name if line.product_uom_id else ''"/>
                    </td>
                    <td t-att-style="'padding:12px 8px; text-align:center; vertical-align:middle; font-size:11.5px; background-color:' + row_bg">
                      <t t-esc="int(line.quantity) if line.quantity == int(line.quantity) else line.quantity"/>
                    </td>
                    <td t-att-style="'padding:12px 8px; text-align:right; font-weight:500; vertical-align:middle; white-space:nowrap; font-size:11.5px; background-color:' + row_bg">
                      <t t-esc="'{:,.0f}'.format(line.price_unit).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                    </td>
                    <td t-att-style="'padding:12px 8px; text-align:right; font-weight:700; vertical-align:middle; white-space:nowrap; font-size:11.5px; background-color:' + row_bg">
                      <t t-esc="'{:,.0f}'.format(line.price_subtotal).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                    </td>
                  </tr>
                </t>
              </t>
            </tbody>
          </table>

          <!-- ════════════════════════════
               BAS DE PAGE
          ════════════════════════════ -->
          <table style="width:100%; border-collapse:collapse; margin-top: 2px;">
            <tr>

              <!-- Coordonn&#233;es bancaires + notes -->
              <td style="width: 57%; padding: 12px 8px 8px 20px; vertical-align: top;">
                <t t-if="doc.company_id.partner_id.bank_ids">
                  <div style="border: 1.5px solid #A8E6EF; border-radius: 8px; padding: 13px 15px; margin-bottom: 10px;">
                    <div style="font-size: 9px; font-weight: 700; letter-spacing: 2.5px; color: #00C5D5; text-transform: uppercase; margin-bottom: 9px;">
                      <svg width="12" height="12" viewBox="0 0 16 16" fill="#00C5D5" style="vertical-align: middle; margin-right: 4px;"><path d="M8 0a8 8 0 1 1 0 16A8 8 0 0 1 8 0zM4.5 7.5a.5.5 0 0 0 0 1h5.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H4.5z"/></svg>
                      Coordonn&#233;es Bancaires
                    </div>
                    <t t-foreach="doc.company_id.partner_id.bank_ids" t-as="bank">
                      <div style="font-size: 11px; color: #1A1A2E; margin-bottom: 4px;">
                        <span style="color: #00C5D5; font-weight: 600;"><t t-esc="bank.bank_id.name if bank.bank_id else 'Banque'"/></span>
                        <br/>
                        <t t-esc="bank.acc_number"/>
                        <t t-if="bank.bank_bic">&#160;&#8211;&#160;BIC&#160;: <t t-esc="bank.bank_bic"/></t>
                      </div>
                    </t>
                  </div>
                </t>
                <t t-if="doc.narration">
                  <div style="border: 1.5px solid #A8E6EF; border-radius: 8px; padding: 13px 15px;">
                    <div style="font-size: 9px; font-weight: 700; letter-spacing: 2.5px; color: #00C5D5; text-transform: uppercase; margin-bottom: 8px;">Notes</div>
                    <div style="font-size: 10.5px; color: #4A5568; line-height: 1.65;">
                      <t t-out="doc.narration"/>
                    </div>
                  </div>
                </t>
              </td>

              <!-- Totaux + Solde -->
              <td style="width: 43%; padding: 12px 20px 8px 8px; vertical-align: top;">

                <table style="width:100%; border-collapse:collapse; border-radius: 8px; overflow: hidden; margin-bottom: 10px;">
                  <tr>
                    <td style="background-color: #005F6B; color: #ffffff; font-size: 12px; font-weight: 700; padding: 9px 14px;">TOTAL HT</td>
                    <td style="background-color: #005F6B; color: #ffffff; font-size: 12px; font-weight: 700; padding: 9px 14px; text-align: right; white-space: nowrap;">
                      <t t-esc="'{:,.0f}'.format(doc.amount_untaxed).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                    </td>
                  </tr>
                  <tr>
                    <td style="background-color: #007A85; color: #ffffff; font-size: 11px; font-weight: 600; padding: 8px 14px;">TVA</td>
                    <td style="background-color: #007A85; color: #ffffff; font-size: 11px; padding: 8px 14px; text-align: right; white-space: nowrap;">
                      <t t-esc="'{:,.0f}'.format(doc.amount_tax).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                    </td>
                  </tr>
                  <tr>
                    <td style="background-color: #00C5D5; color: #ffffff; font-size: 14px; font-weight: 800; padding: 9px 14px; letter-spacing: 0.3px;">TOTAL TTC</td>
                    <td style="background-color: #00C5D5; color: #ffffff; font-size: 14px; font-weight: 800; padding: 9px 14px; text-align: right; white-space: nowrap;">
                      <t t-esc="'{:,.0f}'.format(doc.amount_total).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                    </td>
                  </tr>
                </table>

                <!-- Solde restant si paiement partiel -->
                <t t-if="doc.amount_residual and doc.amount_residual != doc.amount_total and doc.amount_residual > 0">
                  <div style="border: 2px solid #e53e3e; border-radius: 8px; padding: 10px 14px; text-align: center;">
                    <div style="font-size: 10px; font-weight: 700; color: #e53e3e; text-transform: uppercase; letter-spacing: 1.5px; margin-bottom: 4px;">Solde &#224; payer</div>
                    <div style="font-size: 16px; font-weight: 800; color: #e53e3e;">
                      <t t-esc="'{:,.0f}'.format(doc.amount_residual).replace(',', ' ') + ' ' + (doc.currency_id.symbol or '')"/>
                    </div>
                  </div>
                </t>

              </td>
            </tr>
          </table>

          <!-- ════════════════════════════
               FOOTER : SERVICES
          ════════════════════════════ -->
          <table style="width:100%; border-collapse:collapse; margin-top: 12px; background: -webkit-linear-gradient(left, #005F6B, #00C5D5); background: linear-gradient(to right, #005F6B, #00C5D5);">
            <tr>
              <td style="padding: 11px 10px; text-align: center; vertical-align: middle;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: middle; margin-right: 6px;"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
                <span style="color: #ffffff; font-size: 11px; font-weight: 600; vertical-align: middle;">Analyse &amp; Data</span>
              </td>
              <td style="width: 1px; background-color: #7EEAF0; padding: 0;"></td>
              <td style="padding: 11px 10px; text-align: center; vertical-align: middle;">
